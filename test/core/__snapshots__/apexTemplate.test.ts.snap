exports[`generateApexTest > starts an autolaunched Flow with its inputs and reads its outputs 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Calculate_Discount (Calculate Discount).
 * Autolaunched (no trigger).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Calculate_Discount_FlowTest {
    @IsTest
    static void runsFlow() {
        Map<String, Object> inputs = new Map<String, Object>();
        Account accountRecordInput = new Account(
            Name = 'Test Account'
        );
        insert accountRecordInput;
        inputs.put('accountRecord', accountRecordInput);
        inputs.put('contacts', new List<Contact>()); // TODO: Contact collection
        Widget__c widgetInput = new Widget__c();
        // TODO: set the required fields for Widget__c
        insert widgetInput;
        inputs.put('widget', widgetInput);
        inputs.put('codes', new List<String>()); // TODO: String collection
        inputs.put('wrappers', null); // TODO: DiscountWrapper collection
        inputs.put('tier', 'test'); // TODO: Picklist
        inputs.put('isVip', false); // TODO: Boolean
        inputs.put('quantity', 0); // TODO: Number
        inputs.put('startDate', Date.today()); // TODO: Date
        inputs.put('startTime', Datetime.now()); // TODO: DateTime
        inputs.put('customer', null); // TODO: CustomerInfo

        Test.startTest();
        Flow.Interview interview = Flow.Interview.createInterview('Calculate_Discount', inputs);
        interview.start();
        Test.stopTest();

        // TODO: assert what this Flow does
        Object discountOutput = interview.getVariableValue('discount');
        Assert.isNotNull(interview, 'The Flow interview should run');
    }
}
"
`;

