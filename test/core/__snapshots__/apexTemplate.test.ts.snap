exports[`generateApexTest > creates a record for a Create Flow, with date and number criteria 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Opportunity_Create (Opportunity Create).
 * Record-triggered on Opportunity (Create, RecordAfterSave).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Opportunity_Create_FlowTest {
    @IsTest
    static void runsFlowOnCreate() {
        Opportunity testRecord = new Opportunity(
            Name = 'Test Opportunity',
            StageName = 'Prospecting',
            CloseDate = Date.valueOf('2026-12-31'),
            Probability = 50
        );
        // TODO: entry criteria: OwnerId EqualTo $User.Id
        // TODO: entry criteria: Description IsNull

        Test.startTest();
        insert testRecord;
        Test.stopTest();

        Opportunity result = [SELECT Id FROM Opportunity WHERE Id = :testRecord.Id];
        // TODO: query and assert the fields this Flow sets
        Assert.isNotNull(result.Id, 'The Opportunity should be saved');
    }
}
"
`;

exports[`generateApexTest > creates and updates a record for a CreateAndUpdate Flow 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Account_After_Save (Account After Save).
 * Record-triggered on Account (CreateAndUpdate, RecordAfterSave).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Account_After_Save_FlowTest {
    @IsTest
    static void runsFlowOnCreate() {
        Account testRecord = new Account(
            Name = 'Test Account',
            Type = 'Customer - Direct',
            AnnualRevenue = 1001
        );
        // TODO: entry criteria: Rating IsChanged true

        Test.startTest();
        insert testRecord;
        Test.stopTest();

        Account result = [SELECT Id FROM Account WHERE Id = :testRecord.Id];
        // TODO: query and assert the fields this Flow sets
        Assert.isNotNull(result.Id, 'The Account should be saved');
    }

    @IsTest
    static void runsFlowOnUpdate() {
        Account testRecord = new Account(
            Name = 'Test Account'
        );
        insert testRecord;

        Test.startTest();
        testRecord.Type = 'Customer - Direct';
        testRecord.AnnualRevenue = 1001;
        // TODO: entry criteria: Rating IsChanged true
        update testRecord;
        Test.stopTest();

        Account result = [SELECT Id FROM Account WHERE Id = :testRecord.Id];
        // TODO: query and assert the fields this Flow sets
        Assert.isNotNull(result.Id, 'The Account should still exist');
    }
}
"
`;

