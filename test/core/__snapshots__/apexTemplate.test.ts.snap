exports[`generateApexTest assertions from the Flow > asserts the fields the Flow is certain to set 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Job_Flow.
 * Record-triggered on Job__c (Create, RecordBeforeSave).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Job_Flow_FlowTest {
    @IsTest
    static void runsFlowOnCreate() {
        Job__c testRecord = new Job__c();
        // TODO: set the required fields for Job__c

        Test.startTest();
        insert testRecord;
        Test.stopTest();

        Job__c result = [SELECT Id, Status__c, Hours__c, Note__c FROM Job__c WHERE Id = :testRecord.Id];
        Assert.areEqual('Scheduled', result.Status__c, 'First should set Status__c');
        Assert.areEqual(3.0, result.Hours__c, 'Second should set Hours__c');
        // TODO: Third sets Note__c to $Record.Name; assert it
    }
}
"
`;

exports[`generateApexTest assertions from the Flow > asserts the records the Flow creates and links to the record 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Job_Flow.
 * Record-triggered on Job__c (Create, RecordBeforeSave).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Job_Flow_FlowTest {
    @IsTest
    static void runsFlowOnCreate() {
        Job__c testRecord = new Job__c();
        // TODO: set the required fields for Job__c

        Test.startTest();
        insert testRecord;
        Test.stopTest();

        Boolean found1 = false;
        for (Task created1 : [SELECT Id, Subject FROM Task WHERE WhatId = :testRecord.Id]) {
            found1 = found1 || (created1.Subject == 'Call');
        }
        Assert.isTrue(found1, 'First should create a Task');
        Assert.isFalse([SELECT Id FROM Task WHERE WhatId = :testRecord.Id].isEmpty(), 'Second should create a Task');
        // TODO: Third creates a Task; assert it
        // TODO: when Check takes "No Reviewer__c", the Flow also:
        //   creates a Task (Later)
    }
}
"
`;

exports[`generateApexTest assertions from the Flow > expects the custom error the Flow is certain to raise 1`] = `
"/**
 * Starter test generated by sf-flow-coverage for the Flow Job_Flow.
 * Record-triggered on Job__c (Update, RecordBeforeSave).
 * Running this test gives the Flow coverage toward "Deploy processes and flows as active".
 * Replace the TODOs with real data and assertions on what the Flow does.
 */
@IsTest
private class Job_Flow_FlowTest {
    @IsTest
    static void runsFlowOnUpdate() {
        Job__c testRecord = new Job__c();
        // TODO: set the required fields for Job__c
        insert testRecord;

        Test.startTest();
        testRecord.Status__c = 'Closed';
        try {
            update testRecord;
            Assert.fail('No_Date should block this save with a custom error');
        } catch (DmlException e) {
            Assert.isTrue(e.getMessage().contains('Set the job\\'s due date'), e.getMessage());
        }
        Test.stopTest();
    }
}
"
`;

